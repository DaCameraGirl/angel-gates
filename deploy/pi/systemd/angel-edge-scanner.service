[Unit]
Description=Angel Gates QR scanner input service
After=network-online.target angel-edge.service
Wants=network-online.target

[Service]
Type=simple
User=angel
Group=angel
SupplementaryGroups=dialout input
EnvironmentFile=/etc/angel-gates/edge.env
WorkingDirectory=/opt/angel-gates
ExecStart=/opt/angel-gates/deploy/pi/bin/run-scanner-service.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/angel-edge /var/log/angel-edge

[Install]
WantedBy=multi-user.target
