[Unit]
Description=Angel Gates relay pulse service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=angel
Group=angel
SupplementaryGroups=gpio
EnvironmentFile=/etc/angel-gates/edge.env
WorkingDirectory=/opt/angel-gates
ExecStart=/opt/angel-gates/deploy/pi/bin/run-relay-service.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/angel-edge /var/log/angel-edge

[Install]
WantedBy=multi-user.target
