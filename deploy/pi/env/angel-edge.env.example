# Copy to /etc/angel-gates/edge.env and replace every token before pilot use.

ANGEL_EDGE_DB=/var/lib/angel-edge/angel-edge.sqlite3
ANGEL_DEVICE_KEY_FILE=/var/lib/angel-edge/device.key
ANGEL_COMMISSIONING_PAYLOAD_FILE=/var/lib/angel-edge/commissioning-payload.json

ANGEL_EDGE_HOST=0.0.0.0
ANGEL_EDGE_PORT=8765

ANGEL_RELAY_HOST=127.0.0.1
ANGEL_RELAY_PORT=8766
ANGEL_RELAY_TOKEN=replace-with-local-relay-token
ANGEL_RELAY_DRIVER=logging
ANGEL_RELAY_URL=http://127.0.0.1:8766

ANGEL_CAMERA_HOST=127.0.0.1
ANGEL_CAMERA_PORT=8767
ANGEL_CAMERA_TOKEN=replace-with-local-camera-token
ANGEL_CAMERA_RTSP_URL=
ANGEL_CAMERA_ID=front-gate-cam
ANGEL_CAMERA_STORAGE_PATH=/var/lib/angel-edge/camera-clips
ANGEL_CAMERA_CLIP_SECONDS=8
ANGEL_CAMERA_RETENTION_DAYS=14
ANGEL_FFMPEG_PATH=/usr/bin/ffmpeg
ANGEL_CAMERA_URL=http://127.0.0.1:8767

ANGEL_SCANNER_EDGE_URL=http://127.0.0.1:8765
ANGEL_SCANNER_EDGE_TOKEN=replace-with-edge-api-token
ANGEL_SCANNER_GATE_ID=front
ANGEL_SCANNER_ID=pedestal-qr-1
ANGEL_SCANNER_INPUT=stdin
ANGEL_SCANNER_SERIAL_PORT=
ANGEL_SCANNER_BAUDRATE=9600
ANGEL_SCANNER_EVDEV_PATH=

ANGEL_WITNESS_URL=
ANGEL_WITNESS_TOKEN=
ANGEL_ANCHOR_POLL_SECONDS=10
